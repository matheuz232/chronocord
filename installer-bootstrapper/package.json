{
  "name": "chronocord-installer-bootstrapper",
  "version": "1.0.3",
  "private": true,
  "main": "main.cjs",
  "build": {
    "appId": "com.chronocord.installer",
    "productName": "ChronoCord Installer",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload/ChronoCord-Setup-1.0.3.exe",
        "to": "ChronoCord-Setup-1.0.3.exe"
      },
      {
        "from": "assets/chronocord-logo.svg",
        "to": "chronocord-logo.svg"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "ChronoCord-Installer-${version}.${ext}",
      "icon": "assets/chronocord.ico"
    },
    "electronVersion": "38.0.0",
    "directories": {
      "output": "release"
    }
  }
}
